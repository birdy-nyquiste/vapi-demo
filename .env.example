# Local mock mode never calls Vapi. On Vercel set DEMO_MODE=live and DATABASE_URL.
DEMO_MODE=mock
DATABASE_URL=
DEMO_ACCESS_TOKEN=
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_CREDENTIAL_ID=
PUBLIC_BASE_URL=
VAPI_PHONE_NUMBER_ID=
INBOUND_PHONE_NUMBER=
TEST_PHONE_NUMBER=
# Scenario IDs map to saved Vapi Assistant IDs; exported configs must match these versions.
VAPI_ASSISTANT_MAP={}
INBOUND_SCENARIO_ID=echo_demo
# Required only to export an Assistant config. Pick a Chinese-capable combination.
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
VAPI_TRANSCRIBER_PROVIDER=
VAPI_TRANSCRIBER_MODEL=
VAPI_TRANSCRIBER_LANGUAGE=
